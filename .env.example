# ---------------------------------------------------------------------------
# Atlas environment template
# Copy to .env and fill in values. Never commit real keys.
# ---------------------------------------------------------------------------

# Application
ATLAS_ENV=development
ATLAS_DEBUG=true
ATLAS_LOG_LEVEL=INFO
ATLAS_SECRET_KEY=change-me-to-a-long-random-string
ATLAS_API_HOST=0.0.0.0
ATLAS_API_PORT=8000
ATLAS_CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# Persistence
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas
DATABASE_URL_SYNC=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
REDIS_URL=redis://localhost:6379/0

# LLM provider: openai | anthropic | google | ollama | demo
MODEL_PROVIDER=demo
MODEL_NAME=gpt-4.1-mini
EMBEDDING_PROVIDER=demo
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Provider keys (leave empty in demo mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Optional reranker
RERANK_PROVIDER=lexical
COHERE_API_KEY=

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=atlas
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Research budgets
ATLAS_MAX_RESEARCH_TASKS=8
ATLAS_MAX_ITERATIONS=2
ATLAS_MAX_SOURCES=40
ATLAS_MAX_TOKENS=120000
ATLAS_RESEARCH_BUDGET_USD=5.00
ATLAS_MAX_PARALLEL_TASKS=4

# Retrieval
ATLAS_TOP_K=12
ATLAS_RERANK_K=8
ATLAS_MIN_SIMILARITY=0.15
ATLAS_CHUNK_SIZE=800
ATLAS_CHUNK_OVERLAP=120

# Uploads
ATLAS_MAX_UPLOAD_MB=20
ATLAS_UPLOAD_DIR=./data/uploads

# Web tool safety
ATLAS_WEB_SEARCH_ENABLED=true
ATLAS_ALLOWED_URL_SCHEMES=https,http
ATLAS_BLOCKED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.0.0/8,169.254.169.254
ATLAS_WEB_TIMEOUT_SECONDS=15

# Human-in-the-loop
ATLAS_HITL_LOW_CONFIDENCE=0.7
ATLAS_HITL_HIGH_IMPACT=true

# Observability
ATLAS_ENABLE_METRICS=true
